exports/*.md
meta/exports/*.md

# Obsidian workspace files (user-specific, not shared)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json
.obsidian/hotkeys.json
meta/docs/.obsidian/workspace.json
meta/docs/.obsidian/workspace-mobile.json
meta/docs/.obsidian/graph.json
meta/docs/.obsidian/hotkeys.json

# Obsidian plugin settings (user-specific, prevent overwriting other instances)
.obsidian/plugins/*/data.json
meta/docs/.obsidian/plugins/*/data.json

# Obsidian personal config 
.obsidian/app.json 
.obsidian/appearance.json 
.obsidian/community-plugins.json 
.obsidian/core-plugins.json

# Environment variables & API keys
.env
.env.*
*.env
.secrets/
*.pem
sessions/audio/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/


# generated audio/video artifacts (too large for git)
campaign/audio/**/*.mp3
campaign/audio/**/*.mp4
campaign/planning/**/*.mp4
*.srt

# all large media/compiled artifacts
*.aaf
*.wav
*.ogg
*.m4a
*.zip
*.json.gz
